{
  "name": "@hexlet/code",
  "version": "1.0.0",
  "description": "Библиотека для генерации HTML-форм",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf ./dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts src __tests__ vitest.config.ts",
    "lint-fix": "eslint --fix --ext .ts src __tests__ vitest.config.ts",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "vitest-sonar-reporter": "^0.5.0",
    "vite": "^6.0.0"
  }
}
